{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'self' https://mapsandapps.itch.io https://mapsandapps.itch.io/secret-jam-finger-labyrinth;"
        },
        {
          "key": "X-Frame-Options",
          "value": "ALLOW-FROM https://mapsandapps.itch.io;"
        }
      ]
    }
  ]
}
